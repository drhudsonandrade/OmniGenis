{
  "schema": "omnigenis-contribution-provenance-policy-v1",
  "status": "ACTIVE",
  "version": "1.0",
  "effective_date": "2026-09-20",
  "purpose": "Preserve technical authorship and contribution provenance without treating repository metadata as proof of legal ownership.",
  "origin_classes": [
    "REPOSITORY_NATIVE",
    "THIRD_PARTY",
    "MIXED",
    "UNKNOWN"
  ],
  "assistance_classes": [
    "HUMAN_ONLY_DECLARED",
    "AI_ASSISTED_DECLARED",
    "AUTOMATION_ASSISTED_DECLARED",
    "MULTI_TOOL_ASSISTED_DECLARED",
    "UNKNOWN"
  ],
  "technical_evidence_classes": [
    "GIT_HISTORY",
    "PULL_REQUEST",
    "REVIEW_RECORD",
    "SIGNED_OR_VERIFIED_COMMIT_WHEN_AVAILABLE",
    "CHANGESET_MANIFEST"
  ],
  "rules": {
    "append_only_ledger": true,
    "unknown_origin_machine_authorized": false,
    "unknown_assistance_is_historical_or_unresolved_only": true,
    "legal_ownership_inference_from_git": false,
    "third_party_rights_must_use_stage4_to_stage7_controls": true,
    "human_direction_required_for_repository_native_changesets": true,
    "tool_vendor_identity_required": false,
    "personal_identity_duplication_required": false,
    "manifest_hash_algorithm": "sha256"
  },
  "control_paths": {
    "ledger": "config/contribution_provenance_ledger.json",
    "runtime_lock": "locks/runtime-lock.json",
    "evidence_prefix": "docs/evidence/contribution_provenance/"
  }
}
