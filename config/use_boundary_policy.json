{
  "schema": "omnigenis-use-boundary-policy-v1",
  "status": "ACTIVE",
  "version": "1.2",
  "effective_date": "2026-09-20",
  "jurisdiction_profile": "BRAZIL_ANVISA_SINEP",
  "use_classes": [
    "RESEARCH_ONLY",
    "TECHNICAL_QC",
    "WELLNESS_NON_CLINICAL",
    "CLINICAL_DECISION_SUPPORT",
    "CLINICAL_DIAGNOSTIC",
    "REGULATORY_EVIDENCE",
    "MIXED_REPORT_SUITE"
  ],
  "nonclinical_use_classes": [
    "RESEARCH_ONLY",
    "TECHNICAL_QC",
    "WELLNESS_NON_CLINICAL"
  ],
  "clinical_use_classes": [
    "CLINICAL_DECISION_SUPPORT",
    "CLINICAL_DIAGNOSTIC",
    "MIXED_REPORT_SUITE"
  ],
  "regulatory_use_classes": [
    "REGULATORY_EVIDENCE"
  ],
  "rules": {
    "explicit_use_class_required": true,
    "software_must_not_self_classify_regulatory_status": true,
    "software_must_not_self_determine_research_ethics": true,
    "nonclinical_outputs_must_disclaim_clinical_and_regulatory_authorization": true,
    "human_subjects_research_requires_verified_ethics_assessment": true,
    "clinical_release_requires_verified_clinical_validation": true,
    "clinical_release_requires_verified_professional_review": true,
    "clinical_release_requires_verified_regulatory_assessment": true,
    "regulatory_release_requires_verified_regulatory_assessment": true,
    "intended_use_reference_required": true,
    "case_and_input_binding_required": true,
    "purpose_change_requires_new_evaluation": true,
    "research_scope_requires_verified_external_assessment": true,
    "authenticated_external_evidence_required": true,
    "evidence_reuse_requires_exact_binding": true
  },
  "regulatory_decisions_authorizing_stated_use": [
    "CLEARED_FOR_STATED_USE",
    "NOT_REGULATED_FOR_STATED_USE"
  ],
  "research_ethics_decisions_authorizing_research": [
    "APPROVED_FOR_DECLARED_RESEARCH"
  ],
  "official_sources": [
