  "boundary": "This policy enforces an operator-declared use boundary and verifies external evidence. It does not classify OmniGenis as a medical device, grant clinical validity, issue research-ethics approval, or create regulatory clearance.",
  "research_scope_decisions": [
    "HUMAN_SUBJECTS_RESEARCH",
    "NOT_HUMAN_SUBJECTS_RESEARCH"
  ],
