      "source_fields": [
        "clinical_use"
      ]
    },
    "COMMERCIAL": {
      "definition": "Any commercial use or commercial context, including commercial research or a commercial product/service.",
      "minimum_decision": "ALLOW",
      "source_fields": [
        "commercial_use"
      ]
    },
    "DERIVED_DATA": {
      "definition": "Creation or distribution of data derived from a resource. Add COMMERCIAL, CLINICAL, REPORT_GENERATION, or REDISTRIBUTION when those contexts apply.",
      "minimum_decision": "ALLOW",
      "source_fields": [
        "derived_data"
      ]
    },
