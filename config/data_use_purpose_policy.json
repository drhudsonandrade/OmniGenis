      "minimum_decision": "ALLOW",
      "source_fields": [
        "redistribution"
      ]
    },
    "REPORT_GENERATION": {
      "definition": "Generation of an externally delivered report containing or derived from the resource. Add CLINICAL and/or COMMERCIAL when those contexts also apply.",
      "minimum_decision": "ALLOW_WITH_OBLIGATIONS",
      "source_fields": [
        "derived_data",
        "redistribution"
      ]
    },
    "RESEARCH": {
      "definition": "Non-commercial research use. If the activity has any commercial context, COMMERCIAL must also be requested.",
      "minimum_decision": "ALLOW",
      "source_fields": [
        "research_use"
      ]
    }
  },
